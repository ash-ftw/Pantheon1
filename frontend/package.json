    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-markdown": "^9.1.0",
    "react-router": "^7.18.2",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
